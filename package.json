{
  "name": "@nicolastoulemont/minimal-maps",
  "version": "0.0.0",
  "description": "Small map primitives for generative UI: a JSON spec of countries and values, checked and drawn as SVG from pre-projected sheets.",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "storybook": "storybook dev --port 6007",
    "build-storybook": "storybook build",
    "sizes": "pnpm build && node scripts/sizes.ts && oxfmt docs",
    "tidy": "node scripts/tidy.ts && oxfmt src/data"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@storybook/html-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.18.0"
}
