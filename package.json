{
  "name": "@nicolastoulemont/minimal-map-charts",
  "version": "0.0.0",
  "description": "Small map primitives for generative UI: a JSON spec of countries and values, checked and drawn as SVG from pre-projected sheets.",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "storybook": "storybook dev --port 6007",
    "build-storybook": "storybook build",
    "sizes": "pnpm build && node scripts/sizes.ts && oxfmt docs",
    "readme": "node scripts/readme.ts",
    "build:maps": "node scripts/build-maps/index.ts && oxfmt src/data scripts/build-maps/uncoded.gen.ts",
    "mcp:build": "vite build --config examples/mcp-app/vite.config.ts",
    "mcp": "pnpm mcp:build && node examples/mcp-app/server.ts"
  },
  "devDependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@base-ui/react": "^1.9.0",
    "@json-render/core": "0.23.2",
    "@json-render/react": "0.23.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@storybook/html-vite": "^10.6.7",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "6.0.11",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-geo": "^3.1.2",
    "effect": "4.1.2",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.73.0",
    "mapshaper": "0.7.101",
    "motion": "^14.14.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "partial-json": "0.1.7",
    "polyclip-ts": "^0.16.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "solid-js": "1.9.19",
    "storybook": "^10.6.7",
    "svelte": "5.57.3",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vite-plugin-solid": "2.11.16",
    "vitest": "^5.1.0",
    "vue": "3.5.45",
    "world-atlas": "^2.0.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.18.0"
}
